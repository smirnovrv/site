// Модуль объекта внешней обработки "Получение данных из ЕГРЮЛ по API ФНС"

// Возвращает структуру с основным и дополнительными ОКВЭД по ИНН
//
// Параметры:
//  ИНН - Строка - ИНН организации или ИП
//
// Возвращаемое значение:
//  Структура - содержит:
//   * ОсновнойОКВЭД - Структура (Код, Наименование)
//   * ДополнительныеОКВЭД - Массив структур (Код, Наименование)
Функция ПолучитьДанныеОКВЭД(ИНН) Экспорт
	
	// В зависимости от того, какой именно официальный API ФНС используется
	// (СМЭВ, OpenAPI ФНС или специализированный шлюз), 
	// URL и параметры авторизации могут отличаться.
	// Здесь приведен пример для типичного REST API ФНС с выдачей JSON.
	
	Сервер = "api-fns.ru"; // Укажите хост официального API ФНС
	КлючAPI = "ВАШ_КЛЮЧ_ДОСТУПА_АПИ";
	ПутьКМетоду = СтрШаблон("/api/egr?req=%1&key=%2", ИНН, КлючAPI);
	
	Соединение = Новый HTTPСоединение(
		Сервер,
		443,
		,,,
		10,
		Новый ЗащищенноеСоединениеOpenSSL
	);
	
	Запрос = Новый HTTPЗапрос(ПутьКМетоду);
	// Если используется Bearer токен в заголовке, раскомментируйте строку ниже:
	// Запрос.Заголовки.Вставить("Authorization", "Bearer " + КлючAPI); 
	
	Попытка
		Ответ = Соединение.Получить(Запрос);
	Исключение
		Сообщить("Ошибка соединения с сервером ФНС: " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецПопытки;
	
	Если Ответ.КодСостояния <> 200 Тогда
		Сообщить("Ошибка выполнения запроса к API ФНС. Код ответа: " + Ответ.КодСостояния, СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	
	Попытка
		ДанныеЕГРЮЛ = ПрочитатьJSON(Чтение);
	Исключение
		Сообщить("Ошибка разбора JSON ответа ФНС: " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	
	Возврат РазобратьДанныеОКВЭД(ДанныеЕГРЮЛ);
	
КонецФункции

// Разбирает ответ от API ФНС и извлекает ОКВЭДы
Функция РазобратьДанныеОКВЭД(ДанныеЕГРЮЛ)
	
	Результат = Новый Структура;
	Результат.Вставить("ОсновнойОКВЭД", Неопределено);
	Результат.Вставить("ДополнительныеОКВЭД", Новый Массив);
	
	// В официальном формате ФНС данные обычно лежат в узле "items" или аналогичном
	// Внутри структура повторяет формат выписки ЕГРЮЛ (СвОКВЭД, СвОКВЭДОсн, СвОКВЭДДоп)
	Если ТипЗнч(ДанныеЕГРЮЛ) = Тип("Структура") И ДанныеЕГРЮЛ.Свойство("items") Тогда
		
		МассивЭлементов = ДанныеЕГРЮЛ.items;
		Если МассивЭлементов.Количество() = 0 Тогда
			Возврат Результат;
		КонецЕсли;
		
		// Берем первую найденную организацию
		ДанныеОрганизации = МассивЭлементов[0];
		УзелДанных = Неопределено;
		
		Если ДанныеОрганизации.Свойство("ЮЛ") Тогда
			УзелДанных = ДанныеОрганизации.ЮЛ; // Юридическое лицо
		ИначеЕсли ДанныеОрганизации.Свойство("ИП") Тогда
			УзелДанных = ДанныеОрганизации.ИП; // Индивидуальный предприниматель
		КонецЕсли;
		
		Если УзелДанных <> Неопределено И УзелДанных.Свойство("СвОКВЭД") Тогда
			
			СвОКВЭД = УзелДанных.СвОКВЭД;
			
			// 1. Извлекаем основной ОКВЭД
			Если СвОКВЭД.Свойство("СвОКВЭДОсн") Тогда
				ОснОКВЭДДанные = СвОКВЭД.СвОКВЭДОсн;
				
				ОсновнойКод = ?(ОснОКВЭДДанные.Свойство("КодОКВЭД"), ОснОКВЭДДанные.КодОКВЭД, "");
				ОсновнойНаим = ?(ОснОКВЭДДанные.Свойство("НаимОКВЭД"), ОснОКВЭДДанные.НаимОКВЭД, "");
				
				Результат.ОсновнойОКВЭД = Новый Структура("Код, Наименование", ОсновнойКод, ОсновнойНаим);
			КонецЕсли;
			
			// 2. Извлекаем дополнительные ОКВЭДы
			Если СвОКВЭД.Свойство("СвОКВЭДДоп") Тогда
				ДопОКВЭДДанные = СвОКВЭД.СвОКВЭДДоп;
				
				// API может вернуть как массив объектов (если их несколько), так и один объект (если он один)
				Если ТипЗнч(ДопОКВЭДДанные) = Тип("Массив") Тогда
					Для каждого ЭлементДоп Из ДопОКВЭДДанные Цикл
						Код = ?(ЭлементДоп.Свойство("КодОКВЭД"), ЭлементДоп.КодОКВЭД, "");
						Наим = ?(ЭлементДоп.Свойство("НаимОКВЭД"), ЭлементДоп.НаимОКВЭД, "");
						Результат.ДополнительныеОКВЭД.Добавить(Новый Структура("Код, Наименование", Код, Наим));
					КонецЦикла;
				ИначеЕсли ТипЗнч(ДопОКВЭДДанные) = Тип("Структура") Тогда
					Код = ?(ДопОКВЭДДанные.Свойство("КодОКВЭД"), ДопОКВЭДДанные.КодОКВЭД, "");
					Наим = ?(ДопОКВЭДДанные.Свойство("НаимОКВЭД"), ДопОКВЭДДанные.НаимОКВЭД, "");
					Результат.ДополнительныеОКВЭД.Добавить(Новый Структура("Код, Наименование", Код, Наим));
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Пример использования функции (можно разместить в модуле формы)
Процедура ПримерПолученияОКВЭД() Экспорт
	
	ИНН = "7707083893"; // Пример: ИНН ПАО Сбербанк
	ДанныеОКВЭД = ПолучитьДанныеОКВЭД(ИНН);
	
	Если ДанныеОКВЭД <> Неопределено Тогда
		
		Если ДанныеОКВЭД.ОсновнойОКВЭД <> Неопределено Тогда
			Сообщить(СтрШаблон("Основной ОКВЭД: %1 - %2", 
				ДанныеОКВЭД.ОсновнойОКВЭД.Код, 
				ДанныеОКВЭД.ОсновнойОКВЭД.Наименование));
		КонецЕсли;
		
		Для каждого Доп Из ДанныеОКВЭД.ДополнительныеОКВЭД Цикл
			Сообщить(СтрШаблон("Доп. ОКВЭД: %1 - %2", Доп.Код, Доп.Наименование));
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
